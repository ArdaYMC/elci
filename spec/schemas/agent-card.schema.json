{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdaYMC/elci/spec/schemas/agent-card.schema.json",
  "title": "Elçi agent card",
  "type": "object",
  "required": ["elci", "principal", "agents"],
  "properties": {
    "elci": {"const": "0.0.1"},
    "principal": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "fallback": {"type": "string", "pattern": "^mailto:"}
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topics", "endpoint", "keys"],
        "properties": {
          "id": {"type": "string", "format": "uri", "pattern": "^https://"},
          "name": {"type": "string"},
          "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
          "keys": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kty"]}}
        }
      }
    }
  }
}
