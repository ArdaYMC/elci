{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdaYMC/elci/spec/schemas/agent-card.schema.json",
  "title": "Elçi principal card (/.well-known/elci.json)",
  "type": "object",
  "required": [
    "protocol_version",
    "principal",
    "agents"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.0.2"
    },
    "principal": {
      "type": "object",
      "required": [
        "name",
        "domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "pattern": "^mailto:"
        },
        "jwks": {
          "type": "object",
          "required": [
            "keys"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "kty"
                ]
              }
            }
          },
          "description": "Principal keys that sign delegation tokens (spec section 4)."
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topics",
          "endpoint"
        ],
        "oneOf": [
          {
            "required": [
              "jwks"
            ]
          },
          {
            "required": [
              "jwks_uri"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^https://"
          },
          "name": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "endpoint": {
            "type": "string",
            "pattern": "^https://"
          },
          "jwks": {
            "type": "object",
            "required": [
              "keys"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "kty"
                  ]
                }
              }
            }
          },
          "jwks_uri": {
            "type": "string",
            "pattern": "^https://"
          },
          "a2a_card": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
